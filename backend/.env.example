# Host-side development only (npm run dev / npm run seed on your machine).
#
# Inside the compose stack the backend gets DATABASE_URL from docker-compose.yml
# and reaches Postgres as postgres:5432 on the compose network. This file is for
# talking to that same database from outside the stack, where it is published on
# host port 55432.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/shop_187_db?schema=public"
PORT=4000

# Cross-origin access to the API. Leave it unset for the normal setups: the
# browser always reaches /api through a proxy on the same origin (nginx in the
# compose stack, Vite in development), so no CORS headers are needed and none
# are sent.
#
# Set it only if something is served from a different origin — one value or a
# comma-separated list:
#   CORS_ORIGIN=https://shop.teehaus-lindner.de
#   CORS_ORIGIN=http://localhost:5173,http://localhost:4173
#
# "*" lets ANY site read responses from this API. Since the owner endpoints are
# currently unauthenticated and expose customer email addresses, do not use it.
# CORS_ORIGIN=
